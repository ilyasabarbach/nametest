<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/cosmic_midnight</item>
        <item name="android:statusBarColor">@color/cosmic_midnight</item>
        <item name="android:navigationBarColor">@color/cosmic_midnight</item>
    </style>

    <style name="AppTheme.Launch" parent="@style/AppTheme">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@color/cosmic_midnight</item>
        <item name="android:navigationBarColor">@color/cosmic_midnight</item>
    </style>
</resources>
