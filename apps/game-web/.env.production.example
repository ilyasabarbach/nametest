VITE_TARGET_PLATFORM=telegram
VITE_TELEGRAM_BOT_USERNAME=cosmikmatch_bot
VITE_TELEGRAM_MINI_APP_SHORT_NAME=cosmic_match

# Same-origin API routes are used by default. Set these only if API is hosted elsewhere.
# VITE_TELEGRAM_INIT_VERIFY_URL=https://your-domain/api/telegram/init-verify
# VITE_TELEGRAM_STARTAPP_RESOLVE_URL=https://your-domain/api/telegram/startapp-resolve
# VITE_TELEGRAM_SHARE_URL=https://your-domain/api/telegram/share-result

# Set this to a unique value each deployment to invalidate stale restored sessions in Telegram webviews.
# VITE_APP_BUILD_ID=2026-04-06T10:00:00Z
