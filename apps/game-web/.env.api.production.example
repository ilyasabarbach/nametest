# Server-side env for apps/game-web/api/telegram/* routes
TELEGRAM_BOT_TOKEN=replace-with-live-bot-token
TELEGRAM_BOT_USERNAME=cosmikmatch_bot
TELEGRAM_MINI_APP_SHORT_NAME=cosmic_match

# Required for signed deep-link startapp payloads and secure resolve.
TELEGRAM_STARTAPP_SECRET=replace-with-random-long-secret

# Optional but recommended for story share payloads.
# TELEGRAM_PUBLIC_BASE_URL=https://your-public-domain
