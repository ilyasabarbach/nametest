{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@nametests/backend-contracts": ["packages/backend-contracts/src/index.ts"],
      "@nametests/content-packs": ["packages/content-packs/src/index.ts"],
      "@nametests/core": ["packages/core/src/index.ts"],
      "@nametests/platform-sdk": ["packages/platform-sdk/src/index.ts"],
      "@nametests/content-packs/*": ["packages/content-packs/src/*"],
      "@nametests/backend-contracts/*": ["packages/backend-contracts/src/*"]
    }
  }
}
